# ==============================================================================
# OpexNOW (AmtemeterAI) Production Environment Configuration Template
# ==============================================================================
# This template centralizes ALL runtime configuration variables for the
# production deployment. Replace placeholders with actual production values
# before deployment.
#
# CRITICAL: Never commit actual production values to source control.
# Use this template as reference and create .env file with real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Database connection parameters for ASP.NET Core backend
DB_NAME=opexdb
DB_USER=YOUR_PRODUCTION_DB_USER
DB_PASSWORD=YOUR_PRODUCTION_DB_PASSWORD
DB_PORT=5432
DB_HOST=postgres

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# JWT token signing and validation parameters
# IMPORTANT: Generate a secure 256+ bit key for production
JWT_SECRET=YOUR_PRODUCTION_JWT_SIGNING_KEY
JWT_ISSUER=amtemeterai-api
JWT_AUDIENCE=amtemeterai-web

# ------------------------------------------------------------------------------
# SAP ERP INTEGRATION
# ------------------------------------------------------------------------------
# SAP server connection parameters for delivery confirmation and invoice creation
# SAP uses HTTP Basic Authentication (auto-generated from username:password)
SAP_BASE_URL=YOUR_PRODUCTION_SAP_BASE_URL
SAP_CLIENT=YOUR_PRODUCTION_SAP_CLIENT
SAP_USERNAME=YOUR_PRODUCTION_SAP_USERNAME
SAP_PASSWORD=YOUR_PRODUCTION_SAP_PASSWORD

# ------------------------------------------------------------------------------
# PERURI E-METERAI INTEGRATION (On-Premise Stamping)
# ------------------------------------------------------------------------------
# Peruri backend staging service for JWT authentication
PERURI_BACKEND_STG=https://backendservicestg.e-meterai.co.id
PERURI_INVENTORY_STG=https://inventory.peruri.co.id

# Peruri Stamp v2 staging service for e-meterai allotment
PERURI_STAMP_V2_STG=https://stampv2stg.e-meterai.co.id

# Peruri service account credentials
PERURI_USER=YOUR_PRODUCTION_PERURI_USER
PERURI_PASSWORD=YOUR_PRODUCTION_PERURI_PASSWORD

# Peruri token expiry buffer (minutes before expiry to trigger refresh)
PERURI_TOKEN_EXPIRY_BUFFER_MINUTES=5

# ------------------------------------------------------------------------------
# DOCKER CONTAINER INTERNAL NETWORKING (Peruri KeyStamp Adapter)
# ------------------------------------------------------------------------------
# Internal Docker DNS names for container-to-container communication
# These values are used when running in Docker environment
# DO NOT change these unless container names are modified
PERURI_KEYSTAMP_DOCKER=http://signadapter:7777
PERURI_SHARED_FOLDER=/app/sharefolder

# ------------------------------------------------------------------------------
# MINIO OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# MinIO S3-compatible storage for documents and files
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=YOUR_PRODUCTION_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_PRODUCTION_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=amtemeterai-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# SMTP EMAIL SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# AMT corporate mail server for email notifications
SMTP_HOST=mail.amt.co.id
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=YOUR_PRODUCTION_SMTP_USERNAME
SMTP_PASSWORD=YOUR_PRODUCTION_SMTP_PASSWORD
SMTP_SENDER_EMAIL=YOUR_PRODUCTION_SENDER_EMAIL
SMTP_SENDER_NAME=YOUR_PRODUCTION_SENDER_NAME

# ------------------------------------------------------------------------------
# EMAIL ROUTING / ENVIRONMENT TOGGLE
# ------------------------------------------------------------------------------
# EMAIL_STAGING_MODE=true (default) => ALL outgoing email (delivery confirmations,
#   PIN codes) is redirected to EMAIL_STAGING_TO / EMAIL_STAGING_PIN_TO.
# Set EMAIL_STAGING_MODE=false ONLY at go-live to route to the REAL
#   salesperson/customer addresses.
# Change = edit this file, then: docker compose up -d api   (no rebuild needed)
EMAIL_STAGING_MODE=true
EMAIL_STAGING_TO=arga@opexcg.com
EMAIL_STAGING_CC=
EMAIL_STAGING_PIN_TO=arga@opexcg.com

# ------------------------------------------------------------------------------
# GOOGLE MAPS GEOCODING API
# ------------------------------------------------------------------------------
# Google Maps API key for reverse geocoding (GPS coordinates to addresses)
GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY

# ------------------------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------------------------
# Public base URL for frontend (used in email links, QR codes, etc.)
PUBLIC_BASE_URL=YOUR_PRODUCTION_PUBLIC_BASE_URL

# API base URL for backend service calls
API_BASE_URL=YOUR_PRODUCTION_API_BASE_URL

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for API calls
CORS_ORIGINS=YOUR_PRODUCTION_FRONTEND_URL_1,YOUR_PRODUCTION_FRONTEND_URL_2

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------------------------------------------
# These are prefixed with VITE_ and are read by the frontend React application
# In production, VITE_API_URL should be empty (uses relative paths via Nginx)
VITE_API_URL=
VITE_APP_TITLE=OpexNOW
VITE_APP_ENV_TAG=PRODUCTION

# ------------------------------------------------------------------------------
# DOCKER COMPOSE OVERRIDE VALUES
# ------------------------------------------------------------------------------
# These variables override docker-compose.yml service configurations
# Container naming and port mappings
CONTAINER_NAME_PREFIX=opexnow
FRONTEND_PORT=5173
API_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
SIGNADAPTER_PORT=7777
NGINX_PORT=80

# ------------------------------------------------------------------------------
# END OF TEMPLATE
# ------------------------------------------------------------------------------
# Post-Deployment Security Actions:
# 1. Change default admin password (admin@amtemeterai.com / Admin@123)
# 2. Verify all test accounts are disabled or removed
# 3. Rotate all secrets and keys according to security policy
# 4. Enable firewall rules for external endpoints
# 5. Configure backup and disaster recovery procedures
# ------------------------------------------------------------------------------
